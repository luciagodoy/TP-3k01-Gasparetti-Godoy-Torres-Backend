PORT=3000
# "production" en el servidor desplegado. Cambia dos cosas: los errores 500
# dejan de incluir el detalle interno, y el esquema NO se sincroniza solo.
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
# Sólo si la app corre detrás de un proxy inverso (nginx, Render, Railway...).
# Es la cantidad de proxies a confiar; vacío = sin proxy (desarrollo local).
# Sin esto el rate limit agrupa a todos los usuarios bajo la IP del proxy.
TRUST_PROXY=
# Tope de peticiones por IP cada 15 min para toda la API (default: 600).
# Subilo si varias personas salen por la misma IP pública (NAT de la facultad).
RATE_LIMIT_MAX=
DB_HOST=localhost
DB_PORT=3306
DB_NAME=DSW-hoteleria
DB_USER=root
DB_PASSWORD=
DB_SSL=false
DB_CA_PATH=./certs/aiven-ca.pem
# Alternativa a DB_CA_PATH para contenedores y plataformas: el contenido PEM
# del CA pegado directamente (certs/ está en .gitignore y no llega al deploy).
DB_CA_CERT=
# En producción el esquema no se modifica solo. Poné DB_SYNC=alter sólo en el
# primer deploy para crear las tablas, y sacalo después.
DB_SYNC=
JWT_SECRET=change-me
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@hotel.local
ADMIN_PASSWORD=admin123
