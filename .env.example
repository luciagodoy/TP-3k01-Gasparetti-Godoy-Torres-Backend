PORT=3000
# "production" en el servidor desplegado. Cambia dos cosas: los errores 500
# dejan de incluir el detalle interno, y el esquema NO se sincroniza solo.
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
TRUST_PROXY=
RATE_LIMIT_MAX=
DB_HOST=localhost
DB_PORT=3306
DB_NAME=DSW-hoteleria
DB_USER=root
DB_PASSWORD=
DB_SSL=false
DB_CA_PATH=./certs/aiven-ca.pem
DB_CA_CERT=
DB_SYNC=
JWT_SECRET=change-me
# Protege GET /api/cron/expire-reservations. Sin esta variable el cron responde siempre 401.
CRON_SECRET=
# Cuenta admin que se crea la primera vez que arranca el servidor.
# En producción ADMIN_PASSWORD es obligatoria; en local, si queda vacía, se usa "admin123".
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@hotel.local
ADMIN_PASSWORD=
