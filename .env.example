# Server
PORT=3000

# URL of the frontend app allowed to call this API (CORS)
FRONTEND_URL=http://localhost:5173

# Database connection
DB_HOST=localhost
DB_PORT=3306
DB_NAME=DSW-hoteleria
DB_USER=root
DB_PASSWORD=

# Set to "true" when connecting to a managed provider that requires TLS (e.g. Aiven).
# Leave "false" for a local MySQL instance without SSL configured.
DB_SSL=false

# Path to the CA certificate downloaded from the Aiven console (Service settings > CA certificate).
# Only required when DB_SSL=true.
DB_CA_PATH=./certs/aiven-ca.pem

# Auth
JWT_SECRET=change-me
